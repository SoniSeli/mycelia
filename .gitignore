# ---------------------------------------------------------------
# Unity generated folders (the Unity project lives at the repo root)
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle / Android build intermediates
.gradle/
/.utmp/
/ExportedObj/
/[Aa]ssets/Plugins/Android/*.androidlib/build/

# IDE files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and profiler captures (attach captures to docs/ as images instead)
sysinfo.txt
mono_crash.*
*.data
*.raw
*.snap

# Build artifacts
*.apk
*.aab
*.ipa
*.unitypackage
*.app
crashlytics-build.properties

# Addressables / Burst build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# ---------------------------------------------------------------
# Third-party content that may not be redistributed in source form
# (Asset Store content: kept locally, never committed). See docs/design.md#credits.
# ---------------------------------------------------------------
/[Aa]ssets/ThirdParty/
/[Aa]ssets/ThirdParty.meta

# OS files
.DS_Store
Thumbs.db
Desktop.ini
